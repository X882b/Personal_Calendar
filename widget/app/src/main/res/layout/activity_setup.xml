<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/steel"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/chalk"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/chalk"
            android:textSize="16sp" />

        <Button
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/blue"
            android:text="Añadir el widget a la pantalla de inicio"
            android:textColor="#ffffff" />

        <Button
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/raised"
            android:text="Actualizar ahora"
            android:textColor="@color/chalk" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Conectar"
            android:textColor="@color/chalk"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="Lo fácil: en Agenda, abre ⚙ y toca «Conectar el widget».\n\nO pega aquí el enlace de «Configurar el otro móvil»:"
            android:textColor="@color/dim"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="https://…#join=…"
            android:importantForAutofill="no"
            android:inputType="textUri|textMultiLine"
            android:maxLines="3"
            android:textColor="@color/chalk"
            android:textColorHint="@color/dim" />

        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/raised"
            android:text="Conectar"
            android:textColor="@color/chalk" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:lineSpacingExtra="3dp"
            android:text="El widget solo lee el calendario. Los cambios se hacen en la app Agenda. Se actualiza cada 30 minutos más o menos, o al momento con su botón ↻."
            android:textColor="@color/dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
