<?xml version="1.0" encoding="utf-8"?>
<!-- one row of the widget: three day tiles side by side, all as tall as the tallest -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/tile0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:background="@drawable/tile"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/label0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/chalk"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/side0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/free0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="libre"
            android:textColor="@color/dim"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/evs0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tile1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:background="@drawable/tile"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/label1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/chalk"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/side1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/free1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="libre"
            android:textColor="@color/dim"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/evs1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tile2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/tile"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/label2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/chalk"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/side2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/free2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="libre"
            android:textColor="@color/dim"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/evs2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
